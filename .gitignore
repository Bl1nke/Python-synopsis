# Игнорируем текстовые файлы с данными
*.txt
# Но не игнорируем конкретные файлы, если нужно (пример)
!README.md

# Игнорируем системные файлы Python
__pycache__/
*.pyc
*.pyo

# Игнорируем виртуальное окружение
venv/
env/
.venv/

# Игнорируем IDE
.vscode/
.idea/

# Игнорируем секреты
.env
*.key
*.pem